//payment schema
model Payment {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String         @db.ObjectId
  user          User           @relation(fields: [userId], references: [id])
  amount        Float
  currency      String
  status        EPaymentStatus @default(PENDING) // PENDING, COMPLETED, FAILED, CANCELLED
  paymentMethod EPaymentMethod // PAYPAL
  transactionId String? // PayPal transaction ID
  paypalOrderId String? // PayPal order ID
  description   String?
  webhookEvents WebhookEvent[]
}

model WebhookEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String   @unique // PayPal webhook event ID
  eventType   String   // e.g., PAYMENT.CAPTURE.COMPLETED
  resourceType String  // e.g., capture, order
  resourceId  String   // PayPal resource ID
  paymentId   String?  @db.ObjectId
  payment     Payment? @relation(fields: [paymentId], references: [id])
  processed   Boolean  @default(false)
  eventData   Json     // Raw webhook data from PayPal
  createdAt   DateTime @default(now())
  processedAt DateTime?
}
